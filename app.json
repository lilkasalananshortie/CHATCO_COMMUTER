{
  "expo": {
    "name": "ChatCo Commuter",
    "slug": "chatco-commuter-mobile",
    "scheme": "chatco-commuter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChatCo uses your location to show approaching jeepneys and allow you to signal Pick Me Up."
        }
      ],
      "expo-maps",
      "expo-font"
    ],
    "android": {
      "package": "com.chatco.commuter",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "chatco-commuter"
          }
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.chatco.commuter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "ChatCo needs camera access to scan fare receipt QR codes."
      }
    },
    "extra": {
      "googleMapsConfigured": false,
      "cartoApiKey": "cb1_2dut_1_0bf5bd46e8782ff0b7ba6f38",
      "eas": {
        "projectId": "2ee7dd04-381f-4196-b4b5-4f19973181a8"
      }
    },
    "owner": "lilkasalananshortie"
  }
}
