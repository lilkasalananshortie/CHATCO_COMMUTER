{
  "expo": {
    "name": "E-CHATCO Commuter",
    "slug": "chatco-commuter-mobile",
    "scheme": "chatco-commuter",
    "version": "1.0.12",
    "icon": "./assets/logo-e-chatco.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "E-CHATCO uses your location to show approaching jeepneys and allow you to signal Pick Me Up."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "E-CHATCO needs camera access to scan conductor fare QR codes and ride receipts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "E-CHATCO needs access to your photos to upload your ID document.",
          "cameraPermission": "E-CHATCO needs camera access to capture your ID document."
        }
      ],
      "expo-maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050F1A",
          "image": "./assets/splash-transparent.png",
          "imageWidth": 1
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.chatco.commuter",
      "versionCode": 12,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "chatco-commuter"
          }
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.chatco.commuter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "E-CHATCO needs camera access to scan fare receipt QR codes.",
        "NSLocationWhenInUseUsageDescription": "E-CHATCO uses your location to show approaching jeepneys and allow you to signal Pick Me Up."
      }
    },
    "extra": {
      "googleMapsConfigured": false,
      "eas": {
        "projectId": "2ee7dd04-381f-4196-b4b5-4f19973181a8"
      }
    },
    "owner": "lilkasalananshortie"
  }
}
